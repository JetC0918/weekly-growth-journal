# Safe local development settings only. Replace the marked development values
# with unique secrets in the deployment secret manager; never use them there.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-key-change-before-deploy
TOKEN_SIGNING_KEY=local-development-token-key-change-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Keep blank for local Vite /api proxy development. Production requires exact
# HTTPS frontend origins, comma-separated, with no paths or trailing slash.
CORS_ALLOWED_ORIGINS=

# Leave DATABASE_URL blank to use the local Compose PostgreSQL defaults below.
DATABASE_URL=
POSTGRES_DB=weekly_growth_journal
POSTGRES_USER=weekly_growth_journal
POSTGRES_PASSWORD=weekly-growth-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=

# Local fake mode is deterministic, requires DEBUG=true, and never calls a provider.
AI_PROVIDER_MODE=fake
# Optional backend-only provider configuration; AI_API_KEY stays unset.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Set only for production; it contains public routing information, not a secret.
VITE_API_BASE_URL=

# Production secrets must be supplied through the private secret manager and
# must never be copied into this file or committed.
