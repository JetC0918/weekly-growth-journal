{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekly-growth-journal-frontend",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  }
}
